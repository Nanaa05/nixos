{ env }:
''
;;; emacs-exwm.el --- EXWM window manager config (generated by dotfiles/exwm.nix) -*- lexical-binding: t -*-
;; Loaded by ~/.xinitrc:  emacs -l ~/.config/emacs-exwm.el   (after ~/.emacs)

(require 'exwm)

(setq exwm-workspace-number 1) ; one workspace only: every extra one is another full-screen frame (~65 MB)

;; the window-manager Emacs gets its own server so `opa` can reach it
;; (the systemd daemon is a different Emacs): emacsclient -s exwm ...
(require 'server)
(setq server-name "exwm")
(unless (server-running-p) (server-start))

;; name each X window's buffer after its class and title
(add-hook 'exwm-update-class-hook
          (lambda () (exwm-workspace-rename-buffer exwm-class-name)))
(add-hook 'exwm-update-title-hook
          (lambda () (exwm-workspace-rename-buffer
                      (format "%s: %s" exwm-class-name exwm-title))))

;; windows that should float (sxwm: should_float)
(setq exwm-manage-configurations
      '(((member exwm-class-name '("Pcmanfm" "obs")) floating t)))

;; M-& starts several programs at once, each in its own hidden output buffer
(setq async-shell-command-buffer 'new-buffer)
(add-to-list 'display-buffer-alist
             '("\\*Async Shell Command\\*" (display-buffer-no-window)))

(defun my/run (cmd)
  "Return a command that starts CMD detached from Emacs."
  (lambda () (interactive) (start-process-shell-command cmd nil cmd)))

;; print / s-print: same as before (maim region -> clipboard, s-print also saves a file) but
;; Emacs says when it starts and shows maim's error if it fails (Esc cancels the selection).
(defun my/screenshot-run (cmd)
  ;; Emacs frames are see-through (alpha-background), so a capture would include the
  ;; wallpaper blended in. Make every frame opaque while selecting/capturing, then restore.
  (let* ((saved (mapcar (lambda (f) (cons f (or (frame-parameter f 'alpha-background) 100)))
                        (seq-filter #'display-graphic-p (frame-list))))
         (restore (lambda ()
                    (dolist (s saved)
                      (when (frame-live-p (car s))
                        (set-frame-parameter (car s) 'alpha-background (cdr s))))))
         (buf (generate-new-buffer " *screenshot*")))
    (dolist (s saved) (set-frame-parameter (car s) 'alpha-background 100))
    (redisplay t)
    (sleep-for 0.3) ; let the compositor show the opaque frame before maim looks
    (message "Screenshot: drag a region (Esc cancels)")
    (make-process :name "screenshot" :buffer buf :noquery t
                  :connection-type 'pipe ; a pty hangup would kill the xclip that serves the clipboard
                  :command (list "bash" "-c" (concat "set -o pipefail; " cmd))
                  :sentinel (lambda (proc _event)
                              (when (memq (process-status proc) '(exit signal))
                                (funcall restore)
                                (let ((out (string-trim (with-current-buffer buf (buffer-string)))))
                                  (message "%s" (if (zerop (process-exit-status proc))
                                                    "Screenshot copied to clipboard"
                                                  (format "Screenshot failed: %s" out))))
                                (kill-buffer buf))))))
(defun my/screenshot ()
  (interactive)
  (my/screenshot-run "maim -s | xclip -selection clipboard -t image/png >/dev/null 2>&1"))
(defun my/screenshot-save ()
  (interactive)
  (my/screenshot-run "/home/lynaten/.local/bin/screenshot.sh >/dev/null"))

;; window size, like sxwm: s-= / s-- grow and shrink the gap around the whole EXWM screen, s-S-arrows
;; resize the current window by 50 px, s-0 resets gaps and balances windows.
;; The gap shrinks EXWM's workareas, so the frame container gets smaller and the real wallpaper
;; shows around it (an Emacs internal border would be painted opaque black).
(defvar my/gaps 0)
(defvar my/gaps-limit 0 "Largest allowed gap, measured on the unshrunk workareas.")
(defun my/gaps-max ()
  "Largest gap that still leaves a quarter of the smallest workarea in each direction."
  (let ((w (apply #'min (mapcar (lambda (a) (min (oref a width) (oref a height)))
                                exwm-workspace--workareas))))
    (max 0 (/ (- w (/ w 4)) 2))))
(defun my/workareas-shrink (&rest _)
  "Shrink every EXWM workarea by `my/gaps' on all sides (runs after EXWM computes them)."
  (unless (zerop my/gaps)
    (let ((g (min my/gaps (my/gaps-max))))
      (dolist (w exwm-workspace--workareas)
        (with-slots (x y width height) w
          (setf x (+ x g) y (+ y g) width (- width (* 2 g)) height (- height (* 2 g)))
          ;; Emacs rounds its frame down to whole character cells, so a container that is not a
          ;; multiple of the cell size leaves an unpainted strip on the right/bottom (a frozen copy
          ;; of the wallpaper). Make the container a whole number of cells, centred.
          (let* ((cw (frame-char-width)) (ch (frame-char-height))
                 (rw (% width cw)) (rh (% height ch)))
            (setf x (+ x (/ rw 2)) y (+ y (/ rh 2))
                  width (- width rw) height (- height rh))))))))
(advice-add 'exwm-workspace--update-workareas :after #'my/workareas-shrink)
(defun my/gaps-set (n)
  ;; refresh the workareas first (no gap) so the cap is computed from the real size
  (setq my/gaps 0)
  (exwm-workspace--update-workareas)
  (setq my/gaps-limit (my/gaps-max)
        my/gaps (min (max 0 n) my/gaps-limit))
  (exwm-workspace--update-workareas)
  (dolist (f exwm-workspace--list) (exwm-workspace--set-fullscreen f))
  (exwm-layout--refresh)
  (my/mode-line-scale))

;; the mode line shrinks as the gap grows: the default font height with no gap, half of it at the
;; largest gap (my/gaps-max)
(defun my/mode-line-scale ()
  (let* ((ratio (if (zerop my/gaps-limit) 0 (/ (float my/gaps) my/gaps-limit)))
         (height (if (zerop my/gaps)
                     'unspecified ; follow the default face again
                   (round (* (face-attribute 'default :height) (- 1 (* 0.5 ratio)))))))
    (dolist (f '(mode-line mode-line-inactive))
      (set-face-attribute f nil :height height))))
(defun my/gaps-increase () (interactive) (my/gaps-set (+ my/gaps 10)))
(defun my/gaps-decrease () (interactive) (my/gaps-set (- my/gaps 10)))
(defun my/size-reset () (interactive) (my/gaps-set 0) (balance-windows))
(defun my/enlarge-width () (interactive) (enlarge-window-horizontally (/ 50 (frame-char-width))))
(defun my/shrink-width () (interactive) (shrink-window-horizontally (/ 50 (frame-char-width))))
(defun my/enlarge-height () (interactive) (enlarge-window (/ 50 (frame-char-height))))
(defun my/shrink-height () (interactive) (shrink-window (/ 50 (frame-char-height))))

;; keys that always go to Emacs, even when an X window has focus
(setq exwm-input-global-keys
      `(([?\s-r] . exwm-reset)
        ([?\s-b] . switch-to-buffer)
        ([?\s-o] . other-window)
        ([?\s-Q] . kill-current-buffer)
        ([?\s-f] . exwm-layout-toggle-fullscreen)
        ([?\s-p] . exwm-floating-toggle-floating)
        ([?\s-m] . delete-other-windows)
        ([?\s-B] . my/rebuild)
        ([?\s-w] . my/wallpaper-set)
        ([?\s-W] . my/wallpaper-clear)
        ([?\s-=] . my/gaps-increase)
        ([?\s--] . my/gaps-decrease)
        ([?\s-0] . my/size-reset)
        ([S-s-right] . my/enlarge-width)
        ([S-s-left] . my/shrink-width)
        ([S-s-up] . my/shrink-height)
        ([S-s-down] . my/enlarge-height)
        ([?\s-h] . windmove-left)
        ([?\s-j] . windmove-down)
        ([?\s-k] . windmove-up)
        ([?\s-l] . windmove-right)
        ([?\s- ] . (lambda (cmd)
                     (interactive (list (read-shell-command "$ ")))
                     (start-process-shell-command cmd nil cmd)))
        ([?\s-t] . vterm)
        ([s-return] . ,(my/run "st -e /bin/sh -c '. ~/.profile && /bin/sh'"))
        ([?\s-e] . ,(my/run "pcmanfm"))
        ([?\s-&] . ,(my/run "dmenu_run -l 5 -fn 'JetBrains Mono:style=Medium:size=20' -p ' Run > ' -nb '#0a1719' -nf '#c1c5c5' -sb '#154C4E' -sf '#c1c5c5'"))
        ([?\s-z] . ,(my/run "boomer"))
        ([?\s-Z] . ,(my/run "boomer-live"))
        ([print] . my/screenshot)
        ([s-print] . my/screenshot-save)
        ([s-f1] . ,(my/run "xrandr --output ${env.monitorPrimary} --auto --primary --output ${env.monitorExternal} --auto --right-of ${env.monitorPrimary}"))
        ([s-f2] . ,(my/run "xrandr --output ${env.monitorPrimary} --mode ${env.resFHD} --output ${env.monitorExternal} --mode ${env.resFHD} --same-as ${env.monitorPrimary}"))
        ([s-f3] . ,(my/run "xrandr --output ${env.monitorExternal} --off --output ${env.monitorPrimary} --auto --primary"))))

;; C-c is an Emacs prefix (exwm-mode-map: C-c C-q, C-c C-k...), so Ctrl+C never reached
;; Firefox and copy failed with "C-c C-c is undefined". Send a real C-c to the program.
;; setopt runs the option's setter, so this also applies on reload-config.
;; (setopt exwm-input-simulation-keys '(([?\C-c] . [?\C-c])))
;; (setopt exwm-input-simulation-keys '(([?\C-x] . [?\C-x])))
;; (setopt exwm-input-simulation-keys '(([?\C-u] . [?\C-u])))
(setq exwm-input-simulation-keys nil)

;; s-B (super+shift+b): rebuild NixOS and show the output in the *compilation* buffer. It is a comint
;; buffer, so the sudo password can be typed straight into it. Asks which flake config
;; (save/min/max) and remembers the choice for next time.
(defvar my/rebuild-config "max")
(defun my/rebuild ()
  "Run nixos-rebuild switch for a flake config, in a compilation buffer."
  (interactive)
  (setq my/rebuild-config
        (completing-read "Rebuild config: " '("save" "min" "max") nil nil nil nil my/rebuild-config))
  (let ((default-directory (expand-file-name "~/nixos/")))
    (with-current-buffer
        (compile (format "sudo nixos-rebuild switch --flake .#%s" my/rebuild-config) t)
      ;; buffer-local, so it only fires for this build: reload once it succeeded
      (add-hook 'compilation-finish-functions
                (lambda (_buf msg)
                  (if (string-prefix-p "finished" msg)
                      (reload-config)
                    (message "Rebuild failed, config not reloaded")))
                nil t))))
(defalias 'rebuild #'my/rebuild)

;; window-wallpaper: s-w turns the current X buffer into the wallpaper (its buffer goes
;; away, the program keeps running); s-W hands the wallpaper back as a normal buffer.
(defun my/wallpaper-run (&rest args)
  "Run window-wallpaper with ARGS; adopt every window id it prints as an EXWM buffer.
The script leaves those windows mapped; unmapping and adopting happen here, in one go,
so there is no gap between the wallpaper vanishing and the buffer appearing."
  (with-temp-buffer
    (apply #'call-process "/home/lynaten/.local/bin/window-wallpaper" nil t nil args)
    (dolist (id (split-string (buffer-string)))
      (setq id (string-to-number id))
      ;; unmap and adopt in the same breath: picom sees the window appear again at once, so
      ;; it plays its open fade-in on it, with no gap in which another buffer shows
      (xcb:+request exwm--connection (make-instance 'xcb:UnmapWindow :window id))
      (exwm-manage--manage-window id)
      ;; make sure it is the one on screen (manage-window alone may leave another buffer shown)
      (when-let* ((buf (exwm--id->buffer id)))
        (switch-to-buffer buf)))))

(defun my/wallpaper-set ()
  "Make the X window of the current buffer the wallpaper of its monitor."
  (interactive)
  (unless (derived-mode-p 'exwm-mode) (user-error "Not an X window buffer"))
  (let ((id exwm--id))
    (exwm-manage--unmanage-window id 'unmanage)
    (my/wallpaper-run "set" (number-to-string id))))

(defun my/wallpaper-clear ()
  "Hand the wallpaper window back to EXWM as a buffer."
  (interactive)
  (my/wallpaper-run "clear" "exwm"))

;; the key list above names commands defined further down, so it can only be type-checked (and the
;; keys re-grabbed on reload-config) now that they all exist; setopt runs the option's setter
(setopt exwm-input-global-keys exwm-input-global-keys)

(exwm-wm-mode 1)
''
