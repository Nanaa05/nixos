+/// Whether the final frame is composed through the zoom path, instead of being copied.
+static bool renderer_zoom_path(const struct renderer *r) {
+	return r->zoom_scale > 1.0 || r->fl_alpha > 0.001;
+}
+
+void renderer_set_zoom(struct renderer *r, double scale, double x, double y) {
+	bool was_active = renderer_zoom_path(r);
+	r->zoom_scale = scale > 1.0 ? scale : 1.0;
+	r->zoom_x = x;
+	r->zoom_y = y;
+	if (was_active && !renderer_zoom_path(r)) {
+		r->zoom_repaint_frames = r->max_buffer_age + 1;
+	}
+}
+
+void renderer_set_flashlight(struct renderer *r, int x, int y, double radius, double alpha) {
+	bool was_active = renderer_zoom_path(r);
+	r->fl_x = x;
+	r->fl_y = y;
+	r->fl_radius = radius;
+	r->fl_alpha = alpha > 0 ? alpha : 0;
+	if (was_active && !renderer_zoom_path(r)) {
+		r->zoom_repaint_frames = r->max_buffer_age + 1;
+	}
+}
