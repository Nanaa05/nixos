diff --git a/src/picom.c b/src/picom.c
index 71a77b1..9506dee 100644
--- a/src/picom.c
+++ b/src/picom.c
@@ -1171,6 +1171,55 @@ uint8_t session_redirection_mode(session_t *ps) {
  *
  * @return whether the operation succeeded or not
  */
+/// Show an exact copy of what is on the screen right now in our own window, before the
+/// windows get redirected. Redirecting makes the X server stop drawing windows, so until
+/// our first real frame reaches the screen (at the next vblank) only the wallpaper would
+/// be visible. With the copy already presented, that frame is invisible.
+static void present_screen_copy(session_t *ps) {
+	if (!ps->backend_data->ops.present || !ps->backend_data->ops.bind_pixmap) {
+		return;
+	}
+	auto root = ps->c.screen_info->root;
+	xcb_pixmap_t pixmap = x_new_id(&ps->c);
+	xcb_gcontext_t gc = x_new_id(&ps->c);
+	xcb_create_pixmap(ps->c.c, ps->c.screen_info->root_depth, pixmap, root,
+	                  (uint16_t)ps->root_width, (uint16_t)ps->root_height);
+	xcb_create_gc(ps->c.c, gc, root, XCB_GC_SUBWINDOW_MODE,
+	              (const uint32_t[]){XCB_SUBWINDOW_MODE_INCLUDE_INFERIORS});
+	xcb_copy_area(ps->c.c, root, pixmap, gc, 0, 0, 0, 0, (uint16_t)ps->root_width,
+	              (uint16_t)ps->root_height);
+	xcb_aux_sync(ps->c.c);
+
+	auto image = ps->backend_data->ops.bind_pixmap(
+	    ps->backend_data, pixmap,
+	    x_get_visual_info(&ps->c, ps->c.screen_info->root_visual));
+	if (image != NULL) {
+		region_t screen;
+		pixman_region32_init_rect(&screen, 0, 0, (unsigned)ps->root_width,
+		                          (unsigned)ps->root_height);
+		struct backend_blit_args args = {
+		    .source_image = image,
+		    .max_brightness = 1,
+		    .tint = {1, 1, 1, 1},
+		    .effective_size = {ps->root_width, ps->root_height},
+		    .source_mask = NULL,
+		    .target_mask = &screen,
+		    .scale = SCALE_IDENTITY,
+		};
+		if (ps->backend_data->ops.prepare) {
+			ps->backend_data->ops.prepare(ps->backend_data, &screen);
+		}
+		ps->backend_data->ops.blit(ps->backend_data, (ivec2){},
+		                           ps->backend_data->ops.back_buffer(ps->backend_data),
+		                           &args);
+		ps->backend_data->ops.present(ps->backend_data);
+		pixman_region32_fini(&screen);
+		ps->backend_data->ops.release_image(ps->backend_data, image);
+	}
+	xcb_free_gc(ps->c.c, gc);
+	xcb_free_pixmap(ps->c.c, pixmap);
+}
