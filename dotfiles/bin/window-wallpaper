#!/usr/bin/env python3
# window-wallpaper set [window-id]|clear
# (with a window-id, as sent by EXWM, the window is used as-is: Emacs has already
#  unmanaged it, so there is no WM to tell. Clearing maps it again and EXWM adopts
#  it as a new buffer.)
# set:   turn the focused window into the wallpaper of its monitor (borderless,
#        full monitor, below everything, click-through). Audio/video keep playing.
#        The previous wallpaper window of that monitor is handed back to the WM.
# clear: hand every wallpaper window back to the WM and reset the root background to the
#        default image (something else may have set the root pixmap, which windows can't undo).
import json, os, subprocess, sys
from Xlib import X, display, Xatom, protocol
from Xlib.ext import shape, randr

# one state file per X display: window ids are only meaningful inside the X server that
# issued them, so an entry left by an earlier/other X session must never be reused
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
                     "window-wallpaper-%s.json" % os.environ.get("DISPLAY", "").replace(":", "").replace("/", "_"))
d = display.Display()
root = d.screen().root


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except Exception:
        return {}


def save(s):
    with open(STATE, "w") as f:
        json.dump(s, f)


def toplevel(w):
    # climb to the direct child of root
    while True:
        p = w.query_tree().parent
        if p.id == root.id or p.id == 0:
            return w
        w = p


def monitors():
    try:
        return [(m.name and d.get_atom_name(m.name) or str(i), m.x, m.y, m.width_in_pixels, m.height_in_pixels)
                for i, m in enumerate(root.xrandr_get_monitors(True).monitors)]
    except Exception:
        g = root.get_geometry()
        return [("0", 0, 0, g.width, g.height)]


def monitor_for(x, y):
    mons = monitors()
    for m in mons:
        if m[1] <= x < m[1] + m[3] and m[2] <= y < m[2] + m[4]:
            return m
    return mons[0]


def forget(w):
    # sxwm only drops a client on DestroyNotify. Send it a synthetic one so it
    # forgets the window; mapping it again later makes sxwm adopt it as a new
    # window on whichever workspace is current.
    ev = protocol.event.DestroyNotify(event=root, window=w)
    root.send_event(ev, event_mask=X.SubstructureNotifyMask)
    d.sync()


def release(entry, adopt=False):
    # adopt=True (EXWM): leave the window mapped where it is and only make it manageable
    # again; Emacs then adopts it in one step, so there is no frame in which it is gone.
    try:
        # only touch the window if it is still a direct child of root (a wallpaper window);
        # a stale id that now names some other window must be left alone
        if entry["id"] not in [c.id for c in root.query_tree().children]:
            return
        w = d.create_resource_object("window", entry["id"])
        if not adopt:
            w.unmap()
        w.change_attributes(override_redirect=0)
        w.shape_mask(shape.SO.Set, shape.SK.Input, 0, 0, X.NONE)  # full input again
        if not adopt:
            w.configure(x=entry["x"], y=entry["y"], width=entry["w"], height=entry["h"], border_width=entry["bw"])
            w.map()  # WM sees a MapRequest and manages it again
        d.sync()
    except Exception:
        pass


def do_set(wid=None):
    if wid:
        w = d.create_resource_object("window", wid)
        w.reparent(root, 0, 0)  # EXWM keeps clients inside its own frames
        d.sync()
    else:
        focus = d.get_input_focus().focus
        if not hasattr(focus, "query_tree") or focus.id in (0, 1, root.id):
            return
        w = toplevel(focus)
    if w.id == root.id:
        return
    state = load()
    if any(e["id"] == w.id for e in state.values()):
        return
    g = w.get_geometry()
    pos = root.translate_coords(w, 0, 0)
    mon = monitor_for(pos.x + g.width // 2, pos.y + g.height // 2)
    name, mx, my, mw, mh = mon
    released = name in state
    if released:
        old = state.pop(name)
        release(old, adopt=bool(wid))  # EXWM mode: Emacs adopts it (see below)
        if wid:
            print(old["id"])
    entry = {"id": w.id, "x": g.x, "y": g.y, "w": g.width, "h": g.height, "bw": g.border_width}
    w.unmap()
    if not wid:
        forget(w)  # sxwm drops it from its client list (and re-tiles the rest)
    w.change_attributes(override_redirect=1)  # and will ignore it when mapped again
    w.configure(x=mx, y=my, width=mw, height=mh, border_width=0, stack_mode=X.Below)
    w.shape_rectangles(shape.SO.Set, shape.SK.Input, 0, 0, 0, [])  # empty input region: clicks pass through
    w.map()
    w.configure(stack_mode=X.Below)
    d.sync()
    state[name] = entry
    save(state)


def do_clear(exwm=False):
    state = load()
    for e in state.values():
        release(e, adopt=exwm)
        if exwm:
            print(e["id"])  # Emacs adopts these itself, they stay mapped meanwhile
    save({})
    # same command as x11-setup (profiles/min.nix); the root pixmap outlives whoever set it
    try:
        subprocess.run(["xwallpaper", "--zoom", "/home/lynaten/nixos/wallpaper.jpg"], check=False)
    except OSError:
        pass



cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "set":
    do_set(int(sys.argv[2], 0) if len(sys.argv) > 2 else None)
elif cmd == "clear":
    do_clear(len(sys.argv) > 2 and sys.argv[2] == "exwm")
else:
    sys.exit("usage: window-wallpaper set|clear")
